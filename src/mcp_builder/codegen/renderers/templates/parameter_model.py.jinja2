"""Parameter models for tool request bodies.

Each model corresponds to one tool that accepts a JSON request body.
Fields are derived from the OpenAPI spec with YAML description overrides.
"""

from pydantic import BaseModel, Field

{% for tool in tools %}

class {{ tool.class_name }}Params(BaseModel):
    """Request body parameters for the {{ tool.tool_name }} tool."""
{% for field in tool.body_fields %}
{% if field.required %}
    {{ field.py_name }}: {{ field.py_type }} = Field(..., description="{{ field.description | py_string }}")
{% else %}
    {{ field.py_name }}: {{ field.py_type }} | None = Field(default=None, description="{{ field.description | py_string }}")
{% endif %}
{% endfor %}
{% endfor %}
