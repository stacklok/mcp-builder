# MCPServer — ToolHive managed MCP server for {{ server_name }}.
#
# Before applying:
#   1. Build and push the container image ({{ server_name }}-mcp:latest)
#      to a registry your cluster can pull from, then update spec.image.
#   2. If using auth, ensure the MCPExternalAuthConfig is applied first.
#
# Namespace can be changed to match your ToolHive installation.
#
# Docs: https://docs.stacklok.com/toolhive/reference/crd-spec
# Examples: https://github.com/stacklok/toolhive/tree/main/examples/operator/mcp-servers
---
apiVersion: {{ api_version }}
kind: MCPServer
metadata:
  name: {{ server_name }}
  namespace: {{ namespace }}
spec:
  image: {{ server_name }}-mcp:latest
  transport: streamable-http
  permissionProfile:
    type: builtin
    name: network
{% if has_auth %}
  externalAuthConfigRef:
    name: {{ server_name }}-auth
{% endif %}
