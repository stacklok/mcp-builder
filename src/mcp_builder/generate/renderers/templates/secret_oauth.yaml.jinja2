# Secret — OAuth client_secret for {{ server_name }}.
#
# This Secret holds the client_secret issued by the upstream identity
# provider when the OAuth app was registered. Referenced by the
# MCPExternalAuthConfig's upstreamProviders[0].{oidcConfig,oauth2Config}.clientSecretRef.
#
# Before applying:
#   Replace REPLACE_ME with the real client_secret from the upstream IdP
#   (Google Cloud Console, GitHub app settings, Okta admin, etc.).
#
# Namespace must match the MCPExternalAuthConfig and MCPServer.
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ server_name }}-oauth-secret
  namespace: {{ namespace }}
type: Opaque
stringData:
  client-secret: REPLACE_ME
